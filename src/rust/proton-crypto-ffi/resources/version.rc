#include <winver.h>

// VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD, VER_FILE_STRING and VER_PRODUCT_STRING are defined by build.rs
VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
PRODUCTVERSION  VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Proton AG"
      VALUE "FileDescription",  "Proton cryptography native library"
      VALUE "FileVersion",      VER_FILE_STRING
      VALUE "ProductName",      "Proton.Cryptography"
      VALUE "ProductVersion",   VER_PRODUCT_STRING
      VALUE "OriginalFilename", "proton_crypto.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
